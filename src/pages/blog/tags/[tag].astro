---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? data.draft !== true : true);
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  return tags.map(tag => ({
    params: { tag },
    props: { tag },
  }));
}

type Props = {
  tag: string;
};

const { tag } = Astro.props;
const posts = (await getCollection('blog', ({ data }) => {
  if (import.meta.env.PROD && data.draft) return false;
  return data.tags.includes(tag);
})).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={`#${tag}`} description={`Posts tagged with #${tag}`}>
  <div class="tag-view">
    <h1>~/blog/tags/<span class="tag-label">#{tag}</span></h1>
    <p class="count">◈ {posts.length} post{posts.length !== 1 ? 's' : ''}</p>
    <hr class="separator" />

    <a href="/blog" class="back-link">◂ all posts</a>

    {posts.map((post) => (
      <article class="post-preview">
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric', month: 'short', day: 'numeric',
            })}
          </time>
        </div>
        <h2>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p class="description">{post.data.description}</p>
        <a href={`/blog/${post.id}/`} class="read-more">[read more]</a>
      </article>
    ))}
  </div>
</Layout>

<style>
  .tag-view {
    width: 100%;
    padding: 1rem;
    box-sizing: border-box;
  }

  h1 {
    margin-bottom: 0.3rem;
  }

  .tag-label {
    color: rgb(96 165 250);
  }

  .count {
    color: #888;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .separator {
    border: none;
    border-top: 1px solid rgb(96 165 250);
    margin: 0.5rem 0 1.5rem;
  }

  .back-link {
    display: inline-block;
    color: rgb(96 165 250);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .post-preview {
    margin-bottom: 2rem;
  }

  .post-meta {
    color: #888;
    font-size: 0.85rem;
    margin-bottom: 0.2rem;
  }

  .post-meta time {
    color: rgb(96 165 250);
  }

  .post-preview h2 {
    margin: 0.2rem 0;
    font-size: 1.2rem;
  }

  .post-preview h2 a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s;
  }

  .post-preview h2 a:hover {
    border-bottom-color: rgb(96 165 250);
  }

  .description {
    color: #aaa;
    margin: 0.3rem 0;
    line-height: 1.4;
  }

  .read-more {
    color: rgb(96 165 250);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .tag-view {
      padding: 0.75rem;
    }

    .post-preview h2 {
      font-size: 1rem;
    }
  }
</style>