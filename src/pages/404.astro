---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404">
  <div class="not-found-view">
    <h1>~/404</h1>
    <p class="page-subtitle">lost in hyperspace?</p>
    <a href="/" class="back-btn">< back to ~/</a>
  </div>
</Layout>

<style>
  .not-found-view {
    width: 100%;
    height: calc(100vh - var(--navbar-height));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 1rem;
    box-sizing: border-box;
  }

  h1 {
    font-size: 6rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.3rem;
  }

  .page-subtitle {
    color: #8b949e;
    font-size: 13px;
    margin-bottom: 2rem;
  }

  .back-btn {
    display: inline-block;
    color: rgb(239 68 68);
    text-decoration: none;
    font-size: 13px;
  }

  .back-btn:hover {
    text-decoration: underline;
  }
</style>
