---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTags = [...new Set((await getCollection('blog', ({ data }) => import.meta.env.PROD ? data.draft !== true : true)).flatMap(p => p.data.tags))].sort();

const posts = (await getCollection('blog', ({ data }) => import.meta.env.PROD ? data.draft !== true : true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog" description="rants & tech info">
  <div class="blog-index">
    <h1>~/blog</h1>
    <p class="subtitle">rants &amp; tech info</p>

    <div class="search-bar">
      <input type="text" id="search-input" placeholder="search posts..." aria-label="Search blog posts" />
      <span class="search-hint">type to filter</span>
    </div>

    <div class="tag-cloud">
      {allTags.map(tag => (
        <a href={`/blog/tags/${tag}/`} class="tag-link">#{tag}</a>
      ))}
    </div>

    <hr class="separator" />

    <div id="post-list">
      {posts.length === 0 && (
        <p class="empty">No posts yet. Check back later.</p>
      )}

      {posts.map((post) => (
        <article class="post-preview" data-search={post.data.title + ' ' + post.data.description + ' ' + post.data.tags.join(' ')}>
          <div class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric', month: 'short', day: 'numeric',
              })}
            </time>
            {post.data.tags.length > 0 && (
              <span class="tags">
                <span class="meta-sep"> :: </span>{post.data.tags.map(t => <a href={`/blog/tags/${t}/`} class="tag">#{t}</a>)}
              </span>
            )}
          </div>
          <h2>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h2>
          <p class="description">{post.data.description}</p>
          <a href={`/blog/${post.id}/`} class="read-more">[read more]</a>
        </article>
      ))}
    </div>

    <div id="no-results" class="no-results hidden">no posts match your search</div>
  </div>
</Layout>

<script>
  const input = document.getElementById('search-input');
  const list = document.getElementById('post-list');
  const noResults = document.getElementById('no-results');
  const posts = list.querySelectorAll('.post-preview');

  input.addEventListener('input', () => {
    const q = input.value.toLowerCase().trim();
    let visible = 0;

    for (const post of posts) {
      const data = post.dataset.search.toLowerCase();
      if (!q || data.includes(q)) {
        post.classList.remove('hidden');
        visible++;
      } else {
        post.classList.add('hidden');
      }
    }

    if (visible === 0 && q) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  });
</script>

<style>
  .blog-index {
    width: 100%;
    padding: 1rem;
    box-sizing: border-box;
  }

  h1 {
    margin-bottom: 0.3rem;
  }

  .subtitle {
    color: #888;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.75rem 0;
    flex-wrap: wrap;
  }

  #search-input {
    background: #111;
    border: 1px solid #333;
    color: #fff;
    font-family: 'Iosevka', monospace;
    font-size: 0.9rem;
    padding: 0.4rem 0.6rem;
    width: 250px;
    max-width: 100%;
    outline: none;
    transition: border-color 0.2s;
  }

  #search-input:focus {
    border-color: rgb(239 68 68);
  }

  #search-input::placeholder {
    color: #555;
  }

  .search-hint {
    color: #555;
    font-size: 0.8rem;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  .tag-link {
    color: rgb(239 68 68);
    text-decoration: none;
    font-size: 0.85rem;
    border: 1px solid #333;
    padding: 0.15rem 0.5rem;
    transition: border-color 0.2s;
  }

  .tag-link:hover {
    border-color: rgb(239 68 68);
  }

  .separator {
    border: none;
    border-top: 1px solid rgb(239 68 68);
    margin: 0.5rem 0 1.5rem;
  }

  .empty {
    color: #888;
    font-style: italic;
  }

  .post-preview {
    margin-bottom: 2rem;
  }

  .post-preview.hidden {
    display: none;
  }

  .post-meta {
    color: #888;
    font-size: 0.85rem;
    margin-bottom: 0.2rem;
  }

  .post-meta time {
    color: rgb(239 68 68);
  }

  .meta-sep {
    color: #555;
  }

  .reading-time {
    color: #666;
  }

  .tags {
    color: #666;
  }

  .tag {
    color: rgb(239 68 68);
    text-decoration: none;
    margin-right: 0.3rem;
  }

  .tag:hover {
    text-decoration: underline;
  }

  .post-preview h2 {
    margin: 0.2rem 0;
    font-size: 1.2rem;
  }

  .post-preview h2 a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s;
  }

  .post-preview h2 a:hover {
    border-bottom-color: rgb(239 68 68);
  }

  .description {
    color: #aaa;
    margin: 0.3rem 0;
    line-height: 1.4;
  }

  .read-more {
    color: rgb(239 68 68);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .read-more:hover {
    text-decoration: underline;
  }

  .no-results {
    color: #888;
    font-style: italic;
    margin-top: 1rem;
  }

  .no-results.hidden {
    display: none;
  }

  @media (max-width: 480px) {
    .blog-index {
      padding: 0.75rem;
    }

    .post-preview h2 {
      font-size: 1rem;
    }

    #search-input {
      width: 100%;
    }
  }
</style>