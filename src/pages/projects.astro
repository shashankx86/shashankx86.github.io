---
import Layout from '../layouts/Layout.astro';
import ProjectsList from '../components/ProjectsList.astro';
import projectsData from '../data/projects.json';
---

<Layout title="Projects">
  <div class="title-area">
    <h1>~/projects</h1>
    <p class="page-subtitle">stuff i've built</p>
  </div>

  <ProjectsList projects={projectsData.projects} />

  <a href="/" class="back-btn">&#9664; back to ~/</a>
</Layout>

<style>
  .title-area {
    margin-bottom: 20px;
  }

  h1 {
    font-size: 30px;
    font-weight: 700;
    color: #ffffff;
  }

  .page-subtitle {
    color: #8b949e;
    font-size: 13px;
    margin-top: 2px;
  }

  .back-btn {
    display: inline-block;
    margin-top: 36px;
    color: rgb(239 68 68);
    text-decoration: none;
    font-size: 13px;
  }

  .back-btn:hover {
    text-decoration: underline;
  }
</style>
