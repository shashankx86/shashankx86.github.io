---
interface SubItem {
  text: string;
  link?: string;
}

interface Project {
  title: string;
  description: string;
  subItems: SubItem[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="projects-list">
  {projects.map((project) => (
    <article class="project-entry">
      <div class="project-header">
        <span class="project-title">{project.title}</span>
        {project.description && (
          <span class="project-description">{project.description}</span>
        )}
      </div>
      {project.subItems.length > 0 && (
        <ul class="project-links">
          {project.subItems.map((item) => (
            <li class="link-item">
              <span class="link-prefix">◂</span>
              {item.link ? (
                <a href={item.link} target="_blank" rel="noopener">
                  {item.text}
                  <svg class="external-link-icon" viewBox="0 0 24 24" width="12" height="12">
                    <path fill="currentColor" d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" />
                  </svg>
                </a>
              ) : (
                <span>{item.text}</span>
              )}
            </li>
          ))}
        </ul>
      )}
    </article>
  ))}
</div>

<style>
  .projects-list {
    width: 100%;
  }

  .project-entry {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: #0d0d0d;
    transition: background 0.2s;
  }

  .project-entry:hover {
    background: #111;
  }

  .project-header {
    margin-bottom: 0.5rem;
  }

  .project-title {
    display: block;
    color: #fff;
    font-size: 1.1rem;
    margin-bottom: 0.15rem;
  }

  .project-description {
    display: block;
    color: #888;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .project-links {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .link-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
  }

  .link-prefix {
    color: #555;
  }

  .link-item a {
    color: rgb(96 165 250);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-bottom-color 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .link-item a:hover {
    border-bottom-color: rgb(96 165 250);
  }

  .external-link-icon {
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .link-item a:hover .external-link-icon {
    opacity: 1;
  }

  @media (max-width: 480px) {
    .project-entry {
      padding: 0.5rem 0.75rem;
    }

    .project-title {
      font-size: 1rem;
    }

    .project-description {
      font-size: 0.85rem;
    }
  }
</style>
