---
interface SubItem {
  text: string;
  link?: string;
}

interface Project {
  title: string;
  description: string;
  subItems: SubItem[];
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="tree-container">
  <ul class="tree">
    {projects.map((project) => (
      <li>
        <span class="project-name">{project.title}</span>
        {project.description && (
          <div class="description">{project.description}</div>
        )}
        {project.subItems.length > 0 && (
          <ul class="sub-tree">
            {project.subItems.map((item) => (
              <li>
                {item.link ? (
                  <a href={item.link} class="link" target="_blank" rel="noopener">{item.text}<svg class="external-link-icon" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z" /></svg></a>
                ) : (
                  <span>{item.text}</span>
                )}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</div>

<style>
  .tree-container {
    margin-top: 15px;
  }

  .tree,
  .tree ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }

  .tree ul {
    margin-left: 7px;
    border-left: 2px solid rgb(239 68 68);
    padding-left: 26px;
  }

  .tree li {
    position: relative;
    margin-top: 14px;
  }

  .tree li::before {
    content: "";
    position: absolute;
    left: -26px;
    top: 10px;
    width: 20px;
    height: 2px;
    background-color: rgb(239 68 68);
  }

  .tree ul > li:last-child::after {
    content: "";
    position: absolute;
    left: -27px;
    top: 12px;
    bottom: 0;
    width: 3px;
    background-color: #000000;
  }

  .project-name {
    color: #ffffff;
    font-weight: 500;
    font-size: 16px;
  }

  .description {
    color: #8b949e;
    font-size: 14px;
    margin-top: 2px;
    margin-bottom: 6px;
  }

  a.link {
    color: rgb(239 68 68);
    text-decoration: none;
    font-size: 14px;
  }

  a.link:hover {
    text-decoration: underline;
  }

  a.link .external-link-icon {
    opacity: 0.6;
    transition: opacity 0.2s;
    vertical-align: middle;
    margin-left: 3px;
  }

  a.link:hover .external-link-icon {
    opacity: 1;
  }

  .sub-tree {
    margin-top: 4px;
    margin-bottom: 8px;
  }

  .sub-tree li {
    margin-top: 6px;
  }
</style>
